{
  "manifest_version": 3,
  "name": "Dachi",
  "version": "1.3.5",
  "minimum_chrome_version": "111",
  "description": "Dachi — Extension de productivité rédactionnelle pour professionnels de santé. Brouillons administratifs générés par IA. N'est pas un dispositif médical.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.scaleway.ai/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Dachi — Options",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "quick-action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Dachi : action rapide sur le texte sélectionné"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
